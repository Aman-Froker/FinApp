NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/finapp
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma separated. Leave empty in development to allow any origin.
CORS_ORIGINS=
# Set to true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
SENTRY_DSN=
LOG_LEVEL=info
# Parse fallback for SMS the rules miss. Without a key the endpoint answers 503.
ANTHROPIC_API_KEY=
# One call per message shape a phone cannot read; about 0.03 US cents each on Gemini 2.5 Flash.
FALLBACK_MONTHLY_CAP=300
# Email forwarding. Development: in.finapp.test and replay fixtures with `pnpm replay-email`.
# The secret must match the Cloudflare Worker's. Generate with: openssl rand -hex 32
INBOUND_DOMAIN=
INBOUND_SECRET=
